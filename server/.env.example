# --- Database (Neon) ---
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/hrsaas?sslmode=require"

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET="change-me"
REFRESH_SECRET="change-me-too"

# --- Super Admin (internal tool, env-based per spec 5.2) ---
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="change-me"
ADMIN_SECRET="change-me-header-secret"

# --- CORS: comma-separated portal origins ---
CORS_ORIGINS="https://your-customer-portal.vercel.app,https://your-admin-portal.vercel.app"

# --- Email (Resend free tier) — optional; emails are skipped if unset ---
RESEND_API_KEY=""
EMAIL_FROM="HR Platform <onboarding@resend.dev>"
CUSTOMER_PORTAL_URL="https://your-customer-portal.vercel.app"

# --- File storage (Cloudflare R2) — optional; receipt upload disabled if unset ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="hr-saas"

PORT=8080

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/admin"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  SMALL_BUSINESS
  GROWING_BUSINESS
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Admin DB stores tenant metadata and a lightweight user index for login lookups.
// All operational tables (User, Leave, Travel, Payroll, etc.) live in each
// tenant's own isolated database.

// Fast login lookup: find which tenant a user belongs to and verify their
// password without scanning every tenant database.
// Kept in sync by employees.js (create/deactivate/activate) and auth.js (password change).
model UserIndex {
  id           String  @id // Same UUID as User.id in the tenant DB
  tenantId     String
  email        String  @unique
  passwordHash String
  role         String
  active       Boolean @default(true)
}

model Tenant {
  id                      String       @id @default(uuid())
  name                    String
  plan                    Plan
  status                  TenantStatus @default(ACTIVE)
  provisionedAt           DateTime     @default(now())
  headcount               Int          @default(0)
  billingContactName      String?
  billingContactEmail     String?
  databaseUrl             String?
  currency                String       @default("USD")
  expenseFinanceThreshold Decimal      @default(500) @db.Decimal(12, 2)
}
